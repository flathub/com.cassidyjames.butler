{
  "app-id": "com.cassidyjames.butler",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "com.cassidyjames.butler",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--share=network",
    "--device=dri",
    "//": "To restart after changing hardware acceleration setting",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "modules": [
    {
      "name": "butler",
      "buildsystem": "meson",
      "config-opts": [
        "-Dprofile=release"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/cassidyjames/butler.git",
          "tag": "1.8.0",
          "commit": "51d51b6aadf5c10d2a0b2556cfe0a165afed20cf",
          "x-checker-data": {
            "is-main-source": true,
            "type": "git",
            "tag-pattern": "^([\\d.]+)$"
          }
        }
      ]
    }
  ]
}
